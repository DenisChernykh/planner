{
  "name": "planner",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Closed monthly planner backend",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.15.1"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "architecture:check": "depcruise --config .dependency-cruiser.cjs --output-type err src",
    "build": "pnpm run build:compiled",
    "build:clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:compiled": "pnpm run prisma:generate && pnpm run build:clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "check": "pnpm run check:quick && pnpm run test:integration:run && pnpm run test:e2e:run",
    "check:quick": "pnpm run format:check && pnpm run openapi:drift && pnpm run openapi:lint && pnpm run lint && pnpm run typecheck && pnpm run test:run && pnpm run architecture:check && pnpm run build:compiled",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "openapi:drift": "tsx scripts/openapi/check-openapi-drift.ts",
    "openapi:generate": "tsx scripts/openapi/write-openapi.ts --output docs/api/openapi.json",
    "openapi:lint": "redocly lint docs/api/openapi.json",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "provision:pair": "tsx src/bootstrap/provision-pair/main.ts",
    "start:api": "node dist/bootstrap/api/main.js",
    "start:migrate": "prisma migrate deploy --config prisma.config.ts",
    "start:planner-worker": "node dist/bootstrap/planner-worker/main.js",
    "test": "pnpm run test:run",
    "test:contract:run": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.contract.config.mjs --runInBand",
    "test:e2e:run": "pnpm run prisma:generate && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.e2e.config.mjs --runInBand",
    "test:integration:run": "pnpm run prisma:generate && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.integration.config.mjs --runInBand",
    "test:run": "pnpm run test:unit:run && pnpm run test:contract:run",
    "test:unit:run": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.unit.config.mjs --runInBand",
    "typecheck": "pnpm run typecheck:compiled",
    "typecheck:compiled": "pnpm run prisma:generate && pnpm run typecheck:src && pnpm run typecheck:test",
    "typecheck:src": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/instrumentation": "0.221.0",
    "@opentelemetry/instrumentation-http": "0.221.0",
    "@opentelemetry/instrumentation-pg": "0.72.0",
    "@opentelemetry/instrumentation-redis": "0.68.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "helmet": "8.3.0",
    "joi": "18.2.3",
    "jose": "6.2.3",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "prisma": "7.9.0",
    "redis": "6.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@redocly/cli": "2.40.0",
    "@testcontainers/postgresql": "12.0.4",
    "@testcontainers/redis": "12.0.4",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "dependency-cruiser": "18.1.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "jest": "30.4.2",
    "openapi-response-validator": "12.1.3",
    "prettier": "3.9.5",
    "supertest": "7.2.2",
    "testcontainers": "12.0.4",
    "ts-jest": "29.4.11",
    "tsc-alias": "1.9.1",
    "tsx": "4.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.65.0",
    "yaml": "2.9.0"
  }
}
