    "/auth/telegram/callback": {
      "get": {
        "operationId": "completeTelegramOidcLogin",
        "parameters": [
          {
            "description": "Optional OAuth error URI; allowed only with error and ignored by Planner.",
            "in": "query",
            "name": "error_uri",
            "required": false,
            "schema": {
              "maxLength": 2048,
              "minLength": 0,
              "pattern": "^[\\x20-\\x21\\x23-\\x5B\\x5D-\\x7E]*$",
              "type": "string"
            }
          },
          {
            "description": "Optional OAuth error description; allowed only with error and ignored by Planner.",
            "in": "query",
            "name": "error_description",
            "required": false,
            "schema": {
              "maxLength": 1024,
              "minLength": 0,
              "pattern": "^[\\x20-\\x21\\x23-\\x5B\\x5D-\\x7E]*$",
              "type": "string"
            }
          },
          {
            "description": "OAuth error. Supply exactly one of error or code.",
            "in": "query",
            "name": "error",
            "required": false,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[\\x20-\\x21\\x23-\\x5B\\x5D-\\x7E]+$",
              "type": "string"
            }
          },
          {
            "description": "Authorization code. Supply exactly one of code or error.",
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^[\\x21-\\x7E]+$",
              "type": "string"
            }
          },
          {
            "description": "Canonical OIDC state. Required for both success and OAuth error callbacks.",
            "in": "query",
            "name": "state",
            "required": true,
            "schema": {
              "maxLength": 43,
              "minLength": 43,
              "pattern": "^[A-Za-z0-9_-]{43}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Local session created; redirect to the fixed Planner root.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              },
              "Location": {
                "description": "Fixed relative Planner destination.",
                "schema": {
                  "enum": [
                    "/"
                  ],
                  "type": "string"
                }
              },
              "Pragma": {
                "schema": {
                  "enum": [
                    "no-cache"
                  ],
                  "type": "string"
                }
              },
              "Referrer-Policy": {
                "schema": {
                  "enum": [
                    "no-referrer"
                  ],
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "description": "Local session cookie and cleared OIDC state cookie.",
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": "array"
                }
              },
              "X-Request-ID": {
                "description": "Trusted request correlation ID.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "MALFORMED_REQUEST": {
                    "summary": "Malformed request",
                    "value": {
                      "code": "MALFORMED_REQUEST",
                      "detail": "The request could not be parsed.",
                      "instance": "urn:request:01ARZ3NDEKTSV4RRFFQ69G5FAV",
                      "requestId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
                      "status": 400,
                      "title": "Malformed request",
                      "type": "https://planner.invalid/problems/malformed-request"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponseDto"
                }
              }
            },
            "description": "Malformed request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "OIDC_LOGIN_REJECTED": {
                    "summary": "Telegram login rejected",
                    "value": {
                      "code": "OIDC_LOGIN_REJECTED",
                      "detail": "The Telegram login attempt could not be accepted.",
                      "instance": "urn:request:01ARZ3NDEKTSV4RRFFQ69G5FAV",
                      "requestId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
                      "status": 401,
                      "title": "Telegram login rejected",
                      "type": "https://planner.invalid/problems/oidc-login-rejected"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponseDto"
                }
              }
            },
            "description": "Telegram login rejected"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "OIDC_ACCESS_DENIED": {
                    "summary": "Telegram access denied",
                    "value": {
                      "code": "OIDC_ACCESS_DENIED",
                      "detail": "The verified Telegram identity is not allowed to access Planner.",
                      "instance": "urn:request:01ARZ3NDEKTSV4RRFFQ69G5FAV",
                      "requestId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
                      "status": 403,
                      "title": "Telegram access denied",
                      "type": "https://planner.invalid/problems/oidc-access-denied"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponseDto"
                }
              }
            },
            "description": "Telegram access denied"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "PAYLOAD_TOO_LARGE": {
                    "summary": "Payload too large",
                    "value": {
                      "code": "PAYLOAD_TOO_LARGE",
                      "detail": "The request payload exceeds the configured limit.",
                      "instance": "urn:request:01ARZ3NDEKTSV4RRFFQ69G5FAV",
                      "requestId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
                      "status": 413,
                      "title": "Payload too large",
                      "type": "https://planner.invalid/problems/payload-too-large"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponseDto"
                }
              }
            },
            "description": "Payload too large"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "VALIDATION_FAILED": {
                    "summary": "Validation failed",
                    "value": {
                      "code": "VALIDATION_FAILED",
                      "detail": "One or more request fields are invalid.",
                      "errors": [
                        {
                          "code": "invalid_value",
                          "detail": "OIDC callback query is invalid.",
                          "pointer": "/query"
                        }
                      ],
                      "instance": "urn:request:01ARZ3NDEKTSV4RRFFQ69G5FAV",
                      "requestId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
                      "status": 422,
                      "title": "Validation failed",
                      "type": "https://planner.invalid/problems/validation-failed"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemResponseDto"
                }
              }
            },
            "description": "Validation failed\n\nValidation failed"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "DEPENDENCY_UNAVAILABLE": {
                    "summary": "Dependency unavailable",
                    "value": {
                      "code": "DEPENDENCY_UNAVAILABLE",
                      "detail": "A required service is temporarily unavailable.",
                      "instance": "urn:request:01ARZ3NDEKTSV4RRFFQ69G5FAV",
                      "requestId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
                      "status": 503,
                      "title": "Dependency unavailable",
                      "type": "https://planner.invalid/problems/dependency-unavailable"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponseDto"
                }
              }
            },
            "description": "Dependency unavailable"
          }
        },
        "security": [],
        "summary": "Complete the Telegram OpenID Connect authorization ceremony.",
        "tags": [
          "auth"
        ]
      }
    },
