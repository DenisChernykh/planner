{
  "components": {
    "schemas": {
      "ProblemFieldErrorResponseDto": {
        "properties": {
          "code": {
            "example": "invalid_value",
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "detail": {
            "example": "Field has an invalid value.",
            "type": "string"
          },
          "pointer": {
            "example": "/profile/name~1with~0reserved",
            "pattern": "^(?:|(?:/(?:[^~/]|~[01])*)+)$",
            "type": "string"
          }
        },
        "required": [
          "pointer",
          "code",
          "detail"
        ],
        "type": "object"
      },
      "ProblemResponseDto": {
        "properties": {
          "code": {
            "enum": [
              "MALFORMED_REQUEST",
              "NOT_FOUND",
              "CONFLICT",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "VALIDATION_FAILED",
              "RATE_LIMIT_EXCEEDED",
              "INTERNAL_ERROR",
              "DEPENDENCY_UNAVAILABLE"
            ],
            "example": "INTERNAL_ERROR",
            "type": "string"
          },
          "detail": {
            "example": "The server could not complete the request.",
            "type": "string"
          },
          "instance": {
            "example": "urn:request:01ARZ3NDEKTSV4RRFFQ69G5FAV",
            "format": "uri-reference",
            "type": "string"
          },
          "requestId": {
            "example": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
            "type": "string"
          },
          "status": {
            "example": 500,
            "maximum": 599,
            "minimum": 400,
            "type": "number"
          },
          "title": {
            "example": "Internal server error",
            "type": "string"
          },
          "type": {
            "example": "https://planner.invalid/problems/internal-error",
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "requestId"
        ],
        "type": "object"
      },
      "ValidationProblemResponseDto": {
        "properties": {
          "code": {
            "enum": [
              "MALFORMED_REQUEST",
              "NOT_FOUND",
              "CONFLICT",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "VALIDATION_FAILED",
              "RATE_LIMIT_EXCEEDED",
              "INTERNAL_ERROR",
              "DEPENDENCY_UNAVAILABLE"
            ],
            "example": "INTERNAL_ERROR",
            "type": "string"
          },
          "detail": {
            "example": "The server could not complete the request.",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ProblemFieldErrorResponseDto"
            },
            "type": "array"
          },
          "instance": {
            "example": "urn:request:01ARZ3NDEKTSV4RRFFQ69G5FAV",
            "format": "uri-reference",
            "type": "string"
          },
          "requestId": {
            "example": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
            "type": "string"
          },
          "status": {
            "example": 500,
            "maximum": 599,
            "minimum": 400,
            "type": "number"
          },
          "title": {
            "example": "Internal server error",
            "type": "string"
          },
          "type": {
            "example": "https://planner.invalid/problems/internal-error",
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "requestId",
          "errors"
        ],
        "type": "object"
      }
    }
  },
