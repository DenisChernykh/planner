generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  engineType   = "client"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String      @id @default(uuid()) @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  membership Membership?

  @@map("users")
}

model Space {
  id                  String                    @id @default(uuid()) @db.Uuid
  singletonKey        Int                       @unique @default(1) @map("singleton_key") @db.SmallInt
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships         Membership[]
  planMonths          PlanMonth[]
  goalDefinitions     GoalDefinition[]
  seedConsumptions    PlanningSeedConsumption[]
  trackingFactRecords TrackingFactRecord[]
  trackingActions     TrackingActionGroup[]

  @@map("spaces")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  spaceId   String   @map("space_id") @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  slot      Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  space                   Space                     @relation(fields: [spaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  allowlist               TelegramAccessAllowlist?
  planningActions         PlanningActionGroup[]
  ownedDraftGoalRevisions PlanDraftGoalRevision[]
  publishedPlans          PlanPublication[]
  ownedGoalSnapshots      PlanGoalSnapshot[]
  denisSeedBindings       PlanningSeedConsumption[] @relation("SeedDenisMember")
  tanyaSeedBindings       PlanningSeedConsumption[] @relation("SeedTanyaMember")
  createdFactRecords      TrackingFactRecord[]      @relation("FactRecordCreator")
  recordedFactRevisions   TrackingFactRevision[]    @relation("FactRevisionActor")
  trackingActions         TrackingActionGroup[]

  @@unique([spaceId, slot])
  @@unique([spaceId, id])
  @@unique([spaceId, userId])
  @@map("memberships")
}

model TelegramAccessAllowlist {
  userId     String @unique @map("user_id") @db.Uuid
  spaceId    String @map("space_id") @db.Uuid
  telegramId BigInt @unique @map("telegram_id") @db.BigInt

  membership Membership                 @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Restrict, onUpdate: Cascade)
  identities TelegramExternalIdentity[]

  @@id([spaceId, userId])
  @@unique([userId, telegramId])
  @@map("telegram_access_allowlist")
}

model TelegramExternalIdentity {
  issuer         String   @db.VarChar(255)
  subject        String   @db.VarChar(255)
  providerUserId BigInt   @map("provider_user_id") @db.BigInt
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  allowlist TelegramAccessAllowlist @relation(fields: [userId, providerUserId], references: [userId, telegramId], onDelete: Restrict, onUpdate: Restrict)

  @@id([issuer, subject])
  @@unique([issuer, providerUserId])
  @@unique([issuer, userId])
  @@map("telegram_external_identities")
}

model PlanMonth {
  id                  String   @id @default(uuid()) @db.Uuid
  spaceId             String   @map("space_id") @db.Uuid
  monthStart          DateTime @map("month_start") @db.Date
  status              String   @db.VarChar(16)
  revision            BigInt   @db.BigInt
  factsRevision       BigInt   @default(0) @map("facts_revision") @db.BigInt
  createdAt           DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @map("updated_at") @db.Timestamptz(3)
  /// Backed by a physical DEFERRABLE composite FK to
  /// plan_publications(plan_month_id,id), which Prisma cannot model exactly.
  activePublicationId String?  @map("active_publication_id") @db.Uuid

  space             Space                    @relation(fields: [spaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  draft             PlanDraft?
  actions           PlanningActionGroup[]
  draftGoals        PlanDraftGoal[]
  publications      PlanPublication[]
  activePublication PlanPublication?         @relation("ActivePlanPublication", fields: [id, activePublicationId], references: [planMonthId, id], onDelete: Restrict, onUpdate: Restrict, map: "plan_months_active_publication_fkey")
  seedConsumption   PlanningSeedConsumption?
  factRecords       TrackingFactRecord[]
  trackingActions   TrackingActionGroup[]

  @@unique([spaceId, monthStart])
  @@unique([spaceId, id])
  @@map("plan_months")
}

model PlanDraft {
  planMonthId String   @id @map("plan_month_id") @db.Uuid
  focus       String   @db.Text
  revision    BigInt   @db.BigInt
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(3)

  planMonth    PlanMonth         @relation(fields: [planMonthId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  publications PlanPublication[]

  @@map("plan_drafts")
}

model CommandReceipt {
  actorScope        String   @map("actor_scope") @db.VarChar(64)
  commandType       String   @map("command_type") @db.VarChar(128)
  commandId         String   @map("command_id") @db.Uuid
  fingerprint       String   @db.Char(64)
  resultKind        String   @map("result_kind") @db.VarChar(128)
  aggregateId       String   @map("aggregate_id") @db.Uuid
  aggregateRevision BigInt   @map("aggregate_revision") @db.BigInt
  completedAt       DateTime @map("completed_at") @db.Timestamptz(3)

  planningActions PlanningActionGroup[]
  trackingActions TrackingActionGroup[]

  @@id([actorScope, commandType, commandId])
  @@map("command_receipts")
}

model PlanningActionGroup {
  id               String   @id @default(uuid()) @db.Uuid
  actionKind       String   @map("action_kind") @db.VarChar(32)
  actorKind        String   @map("actor_kind") @db.VarChar(16)
  actorScope       String   @map("actor_scope") @db.VarChar(64)
  memberId         String?  @map("member_id") @db.Uuid
  systemActorId    String?  @map("system_actor_id") @db.VarChar(32)
  planMonthId      String?  @map("plan_month_id") @db.Uuid
  goalDefinitionId String?  @map("goal_definition_id") @db.Uuid
  commandType      String   @map("command_type") @db.VarChar(128)
  commandId        String   @map("command_id") @db.Uuid
  beforeRevision   BigInt?  @map("before_revision") @db.BigInt
  afterRevision    BigInt   @map("after_revision") @db.BigInt
  occurredAt       DateTime @map("occurred_at") @db.Timestamptz(3)

  member            Membership?                @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  planMonth         PlanMonth?                 @relation(fields: [planMonthId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  goalDefinition    GoalDefinition?            @relation(fields: [goalDefinitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  commandReceipt    CommandReceipt             @relation(fields: [actorScope, commandType, commandId], references: [actorScope, commandType, commandId], onDelete: Restrict, onUpdate: Restrict)
  focusChange       PlanningMonthFocusChange?
  goalCatalogChange PlanningGoalCatalogChange?
  draftGoalChange   PlanningDraftGoalChange?
  publicationChange PlanningPublicationChange?
  monthCopyChange   PlanningMonthCopyChange?
  seedConsumption   PlanningSeedConsumption?

  @@unique([actorScope, commandType, commandId])
  @@map("planning_action_groups")
}

model PlanningMonthFocusChange {
  actionId    String  @id @map("action_id") @db.Uuid
  beforeFocus String? @map("before_focus") @db.Text
  afterFocus  String  @map("after_focus") @db.Text

  action PlanningActionGroup @relation(fields: [actionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("planning_month_focus_changes")
}

model GoalDefinition {
  id         String    @id @default(uuid()) @db.Uuid
  spaceId    String    @map("space_id") @db.Uuid
  state      String    @db.VarChar(16)
  revision   BigInt    @db.BigInt
  createdAt  DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @map("updated_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  space             Space                       @relation(fields: [spaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  series            GoalSeries[]
  versions          GoalDefinitionVersion[]
  actions           PlanningActionGroup[]
  catalogChanges    PlanningGoalCatalogChange[] @relation("CatalogChangeTarget")
  copiedFromChanges PlanningGoalCatalogChange[] @relation("CatalogChangeSource")
  draftGoals        PlanDraftGoal[]

  @@unique([spaceId, id])
  @@index([spaceId, state, createdAt, id])
  @@map("goal_definitions")
}

model GoalSeries {
  id               String   @id @default(uuid()) @db.Uuid
  goalDefinitionId String   @map("goal_definition_id") @db.Uuid
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)

  goalDefinition     GoalDefinition          @relation(fields: [goalDefinitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions           GoalDefinitionVersion[]
  draftGoalRevisions PlanDraftGoalRevision[]
  goalSnapshots      PlanGoalSnapshot[]

  @@unique([goalDefinitionId, id])
  @@map("goal_series")
}

model GoalDefinitionVersion {
  id               String   @id @default(uuid()) @db.Uuid
  goalDefinitionId String   @map("goal_definition_id") @db.Uuid
  versionNumber    BigInt   @map("version_number") @db.BigInt
  goalSeriesId     String   @map("goal_series_id") @db.Uuid
  seriesDecision   String   @map("series_decision") @db.VarChar(16)
  title            String   @db.Text
  why              String   @db.Text
  category         String   @db.Text
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)

  goalDefinition           GoalDefinition              @relation(fields: [goalDefinitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  goalSeries               GoalSeries                  @relation(fields: [goalDefinitionId, goalSeriesId], references: [goalDefinitionId, id], onDelete: Restrict, onUpdate: Restrict)
  catalogBeforeChanges     PlanningGoalCatalogChange[] @relation("CatalogBeforeVersion")
  catalogAfterChanges      PlanningGoalCatalogChange[] @relation("CatalogAfterVersion")
  catalogCopySourceChanges PlanningGoalCatalogChange[] @relation("CatalogCopySourceVersion")
  draftGoalRevisions       PlanDraftGoalRevision[]
  goalSnapshots            PlanGoalSnapshot[]

  @@unique([goalDefinitionId, versionNumber])
  @@unique([goalDefinitionId, id])
  @@map("goal_definition_versions")
}

model PlanningGoalCatalogChange {
  actionId               String  @id @map("action_id") @db.Uuid
  goalDefinitionId       String  @map("goal_definition_id") @db.Uuid
  beforeState            String? @map("before_state") @db.VarChar(16)
  afterState             String  @map("after_state") @db.VarChar(16)
  beforeVersionId        String? @map("before_version_id") @db.Uuid
  afterVersionId         String? @map("after_version_id") @db.Uuid
  copySourceDefinitionId String? @map("copy_source_definition_id") @db.Uuid
  copySourceVersionId    String? @map("copy_source_version_id") @db.Uuid
  seriesDecision         String? @map("series_decision") @db.VarChar(16)

  action               PlanningActionGroup    @relation(fields: [actionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  goalDefinition       GoalDefinition         @relation("CatalogChangeTarget", fields: [goalDefinitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  beforeVersion        GoalDefinitionVersion? @relation("CatalogBeforeVersion", fields: [goalDefinitionId, beforeVersionId], references: [goalDefinitionId, id], onDelete: Restrict, onUpdate: Restrict)
  afterVersion         GoalDefinitionVersion? @relation("CatalogAfterVersion", fields: [goalDefinitionId, afterVersionId], references: [goalDefinitionId, id], onDelete: Restrict, onUpdate: Restrict)
  copySourceDefinition GoalDefinition?        @relation("CatalogChangeSource", fields: [copySourceDefinitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  copySourceVersion    GoalDefinitionVersion? @relation("CatalogCopySourceVersion", fields: [copySourceDefinitionId, copySourceVersionId], references: [goalDefinitionId, id], onDelete: Restrict, onUpdate: Restrict)

  @@map("planning_goal_catalog_changes")
}

model PlanDraftGoal {
  id                String    @id @default(uuid()) @db.Uuid
  spaceId           String    @map("space_id") @db.Uuid
  planMonthId       String    @map("plan_month_id") @db.Uuid
  goalDefinitionId  String    @map("goal_definition_id") @db.Uuid
  displayOrder      Int       @map("display_order")
  currentRevisionId String?   @map("current_revision_id") @db.Uuid
  attachedAt        DateTime  @map("attached_at") @db.Timestamptz(3)
  detachedAt        DateTime? @map("detached_at") @db.Timestamptz(3)
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(3)

  planMonth          PlanMonth                 @relation(fields: [spaceId, planMonthId], references: [spaceId, id], onDelete: Restrict, onUpdate: Restrict)
  goalDefinition     GoalDefinition            @relation(fields: [spaceId, goalDefinitionId], references: [spaceId, id], onDelete: Restrict, onUpdate: Restrict)
  revisions          PlanDraftGoalRevision[]   @relation("DraftGoalRevisions")
  currentRevision    PlanDraftGoalRevision?    @relation("CurrentDraftGoalRevision", fields: [id, currentRevisionId], references: [planGoalId, id], onDelete: Restrict, onUpdate: Restrict)
  changes            PlanningDraftGoalChange[]
  publishedSnapshots PlanGoalSnapshot[]

  @@unique([id, spaceId, goalDefinitionId])
  @@unique([id, currentRevisionId])
  @@map("plan_draft_goals")
}

model PlanDraftGoalRevision {
  id                      String   @id @default(uuid()) @db.Uuid
  planGoalId              String   @map("plan_goal_id") @db.Uuid
  spaceId                 String   @map("space_id") @db.Uuid
  goalDefinitionId        String   @map("goal_definition_id") @db.Uuid
  revisionNumber          BigInt   @map("revision_number") @db.BigInt
  goalDefinitionVersionId String   @map("goal_definition_version_id") @db.Uuid
  goalSeriesId            String   @map("goal_series_id") @db.Uuid
  scopeKind               String   @map("scope_kind") @db.VarChar(16)
  ownerMemberId           String?  @map("owner_member_id") @db.Uuid
  config                  Json     @db.JsonB
  sourceProvenance        Json?    @map("source_provenance") @db.JsonB
  createdAt               DateTime @map("created_at") @db.Timestamptz(3)

  planGoal              PlanDraftGoal             @relation("DraftGoalRevisions", fields: [planGoalId, spaceId, goalDefinitionId], references: [id, spaceId, goalDefinitionId], onDelete: Restrict, onUpdate: Restrict)
  currentFor            PlanDraftGoal?            @relation("CurrentDraftGoalRevision")
  goalDefinitionVersion GoalDefinitionVersion     @relation(fields: [goalDefinitionId, goalDefinitionVersionId], references: [goalDefinitionId, id], onDelete: Restrict, onUpdate: Restrict)
  goalSeries            GoalSeries                @relation(fields: [goalDefinitionId, goalSeriesId], references: [goalDefinitionId, id], onDelete: Restrict, onUpdate: Restrict)
  owner                 Membership?               @relation(fields: [spaceId, ownerMemberId], references: [spaceId, id], onDelete: Restrict, onUpdate: Restrict)
  beforeChanges         PlanningDraftGoalChange[] @relation("DraftGoalBeforeRevision")
  afterChanges          PlanningDraftGoalChange[] @relation("DraftGoalAfterRevision")
  publishedSnapshots    PlanGoalSnapshot[]

  @@unique([planGoalId, revisionNumber])
  @@unique([planGoalId, id])
  @@map("plan_draft_goal_revisions")
}

model PlanningDraftGoalChange {
  actionId           String   @id @map("action_id") @db.Uuid
  planGoalId         String?  @map("plan_goal_id") @db.Uuid
  beforeRevisionId   String?  @map("before_revision_id") @db.Uuid
  afterRevisionId    String?  @map("after_revision_id") @db.Uuid
  reorderedGoalCount Int?     @map("reordered_goal_count")
  beforeOrder        String[] @default([]) @map("before_order") @db.Uuid
  afterOrder         String[] @default([]) @map("after_order") @db.Uuid

  action         PlanningActionGroup    @relation(fields: [actionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  planGoal       PlanDraftGoal?         @relation(fields: [planGoalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  beforeRevision PlanDraftGoalRevision? @relation("DraftGoalBeforeRevision", fields: [planGoalId, beforeRevisionId], references: [planGoalId, id], onDelete: Restrict, onUpdate: Restrict)
  afterRevision  PlanDraftGoalRevision? @relation("DraftGoalAfterRevision", fields: [planGoalId, afterRevisionId], references: [planGoalId, id], onDelete: Restrict, onUpdate: Restrict)

  @@map("planning_draft_goal_changes")
}

model PlanPublication {
  id                         String   @id(map: "plan_publications_pkey") @db.Uuid
  spaceId                    String   @map("space_id") @db.Uuid
  planMonthId                String   @map("plan_month_id") @db.Uuid
  publicationRevision        BigInt   @map("publication_revision") @db.BigInt
  sourceDraftRevision        BigInt   @map("source_draft_revision") @db.BigInt
  sourcePlanMonthRevision    BigInt   @map("source_plan_month_revision") @db.BigInt
  focus                      String   @db.Text
  activationMode             String   @map("activation_mode") @db.VarChar(16)
  activeLocalDate            DateTime @map("active_local_date") @db.Date
  latePublication            Boolean  @map("late_publication")
  timeZone                   String   @map("time_zone") @db.VarChar(64)
  sourcePreviewSchemaVersion String   @map("source_preview_schema_version") @db.VarChar(100)
  previewHashVersion         String   @map("preview_hash_version") @db.VarChar(100)
  previewHash                String   @map("preview_hash") @db.Char(64)
  calendarFormulaVersion     String   @map("calendar_formula_version") @db.VarChar(100)
  evaluationFormulaVersion   String   @map("evaluation_formula_version") @db.VarChar(100)
  scoreFormulaVersion        String   @map("score_formula_version") @db.VarChar(100)
  publishedByMemberId        String   @map("published_by_member_id") @db.Uuid
  publishedAt                DateTime @map("published_at") @db.Timestamptz(3)

  planMonth       PlanMonth                   @relation(fields: [spaceId, planMonthId], references: [spaceId, id], onDelete: Restrict, onUpdate: Restrict, map: "plan_publications_month_fkey")
  sourceDraft     PlanDraft                   @relation(fields: [planMonthId], references: [planMonthId], onDelete: Restrict, onUpdate: Restrict, map: "plan_publications_draft_fkey")
  /// Prisma cannot infer physical one-to-one from unique `plan_months.id`
  /// inside the deferrable composite FK, so the inverse is modeled as a list.
  activeForMonths PlanMonth[]                 @relation("ActivePlanPublication")
  publishedBy     Membership                  @relation(fields: [spaceId, publishedByMemberId], references: [spaceId, id], onDelete: Restrict, onUpdate: Restrict, map: "plan_publications_publisher_fkey")
  goalSnapshots   PlanGoalSnapshot[]
  changes         PlanningPublicationChange[]
  copiedDrafts    PlanningMonthCopyChange[]
  factRecords     TrackingFactRecord[]
  trackingActions TrackingActionGroup[]

  @@unique([planMonthId, publicationRevision], map: "plan_publications_month_revision_key")
  @@unique([planMonthId, id], map: "plan_publications_month_id_key")
  @@unique([spaceId, id], map: "plan_publications_space_id_key")
  @@map("plan_publications")
}

model PlanGoalSnapshot {
  id                        String  @id(map: "plan_goal_snapshots_pkey") @db.Uuid
  publicationId             String  @map("publication_id") @db.Uuid
  spaceId                   String  @map("space_id") @db.Uuid
  planMonthId               String  @map("plan_month_id") @db.Uuid
  sourcePlanGoalId          String  @map("source_plan_goal_id") @db.Uuid
  sourceDraftGoalRevisionId String  @map("source_draft_goal_revision_id") @db.Uuid
  sourceConfigRevision      BigInt  @map("source_config_revision") @db.BigInt
  goalDefinitionId          String  @map("goal_definition_id") @db.Uuid
  goalDefinitionVersionId   String  @map("goal_definition_version_id") @db.Uuid
  goalSeriesId              String  @map("goal_series_id") @db.Uuid
  displayOrder              Int     @map("display_order")
  title                     String  @db.Text
  why                       String  @db.Text
  category                  String  @db.Text
  scopeKind                 String  @map("scope_kind") @db.VarChar(16)
  ownerMemberId             String? @map("owner_member_id") @db.Uuid
  config                    Json    @db.JsonB
  sourceProvenance          Json?   @map("source_provenance") @db.JsonB
  calendar                  Json    @db.JsonB

  publication             PlanPublication       @relation(fields: [planMonthId, publicationId], references: [planMonthId, id], onDelete: Restrict, onUpdate: Restrict, map: "plan_goal_snapshots_publication_fkey")
  sourcePlanGoal          PlanDraftGoal         @relation(fields: [sourcePlanGoalId, spaceId, goalDefinitionId], references: [id, spaceId, goalDefinitionId], onDelete: Restrict, onUpdate: Restrict, map: "plan_goal_snapshots_source_root_fkey")
  sourceDraftGoalRevision PlanDraftGoalRevision @relation(fields: [sourcePlanGoalId, sourceDraftGoalRevisionId], references: [planGoalId, id], onDelete: Restrict, onUpdate: Restrict, map: "plan_goal_snapshots_source_revision_fkey")
  goalDefinitionVersion   GoalDefinitionVersion @relation(fields: [goalDefinitionId, goalDefinitionVersionId], references: [goalDefinitionId, id], onDelete: Restrict, onUpdate: Restrict, map: "plan_goal_snapshots_definition_version_fkey")
  goalSeries              GoalSeries            @relation(fields: [goalDefinitionId, goalSeriesId], references: [goalDefinitionId, id], onDelete: Restrict, onUpdate: Restrict, map: "plan_goal_snapshots_series_fkey")
  owner                   Membership?           @relation(fields: [spaceId, ownerMemberId], references: [spaceId, id], onDelete: Restrict, onUpdate: Restrict, map: "plan_goal_snapshots_owner_fkey")
  fixedExpectations       FixedExpectation[]
  flexiblePeriods         FlexiblePeriod[]
  factRecords             TrackingFactRecord[]
  trackingActions         TrackingActionGroup[]

  @@unique([publicationId, sourcePlanGoalId], map: "plan_goal_snapshots_publication_source_key")
  @@unique([publicationId, displayOrder], map: "plan_goal_snapshots_publication_order_key")
  @@unique([publicationId, id], map: "plan_goal_snapshots_publication_id_key")
  @@map("plan_goal_snapshots")
}

model FixedExpectation {
  id                 String   @id(map: "fixed_expectations_pkey") @db.Uuid
  publicationId      String   @map("publication_id") @db.Uuid
  planGoalSnapshotId String   @map("plan_goal_snapshot_id") @db.Uuid
  expectationDate    DateTime @map("expectation_date") @db.Date
  componentKind      String   @map("component_kind") @db.VarChar(24)
  componentId        String?  @map("component_id") @db.Uuid

  planGoalSnapshot PlanGoalSnapshot     @relation(fields: [publicationId, planGoalSnapshotId], references: [publicationId, id], onDelete: Restrict, onUpdate: Restrict, map: "fixed_expectations_publication_snapshot_fkey")
  factRecords      TrackingFactRecord[]

  /// The null-safe stable key is physical PostgreSQL `UNIQUE NULLS NOT DISTINCT`
  /// in migration 20260811151000 and intentionally has no Prisma @@unique model.
  @@map("fixed_expectations")
}

model FlexiblePeriod {
  id                 String     @id(map: "flexible_periods_pkey") @db.Uuid
  publicationId      String     @map("publication_id") @db.Uuid
  planGoalSnapshotId String     @map("plan_goal_snapshot_id") @db.Uuid
  periodKind         String     @map("period_kind") @db.VarChar(24)
  ordinal            Int
  periodStart        DateTime   @map("period_start") @db.Date
  periodEnd          DateTime   @map("period_end") @db.Date
  periodDays         Int?       @map("period_days")
  activeDates        DateTime[] @map("active_dates") @db.Date
  eligibleDates      DateTime[] @map("eligible_dates") @db.Date
  periodTarget       Int        @map("period_target")

  planGoalSnapshot PlanGoalSnapshot     @relation(fields: [publicationId, planGoalSnapshotId], references: [publicationId, id], onDelete: Restrict, onUpdate: Restrict, map: "flexible_periods_publication_snapshot_fkey")
  factRecords      TrackingFactRecord[]

  @@unique([publicationId, planGoalSnapshotId, periodKind, periodStart, periodEnd], map: "flexible_periods_stable_key")
  @@unique([publicationId, planGoalSnapshotId, periodKind, ordinal], map: "flexible_periods_ordinal_key")
  @@map("flexible_periods")
}

model PlanningPublicationChange {
  actionId                      String  @id(map: "planning_publication_changes_pkey") @map("action_id") @db.Uuid
  publicationId                 String  @map("publication_id") @db.Uuid
  changeKind                    String  @map("change_kind") @db.VarChar(16)
  confirmedDraftRevision        BigInt? @map("confirmed_draft_revision") @db.BigInt
  confirmedPreviewSchemaVersion String? @map("confirmed_preview_schema_version") @db.VarChar(100)
  confirmedPreviewHashVersion   String? @map("confirmed_preview_hash_version") @db.VarChar(100)
  confirmedPreviewHash          String? @map("confirmed_preview_hash") @db.Char(64)
  beforeActivePublicationId     String? @map("before_active_publication_id") @db.Uuid
  afterActivePublicationId      String? @map("after_active_publication_id") @db.Uuid

  action      PlanningActionGroup @relation(fields: [actionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "planning_publication_changes_action_fkey")
  publication PlanPublication     @relation(fields: [publicationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "planning_publication_changes_publication_fkey")

  @@unique([publicationId, changeKind], map: "planning_publication_changes_publication_kind_key")
  @@map("planning_publication_changes")
}

model PlanningMonthCopyChange {
  actionId            String   @id @map("action_id") @db.Uuid
  sourcePublicationId String   @map("source_publication_id") @db.Uuid
  copiedGoalCount     Int      @map("copied_goal_count")
  afterOrder          String[] @map("after_order") @db.Uuid

  action            PlanningActionGroup @relation(fields: [actionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourcePublication PlanPublication     @relation(fields: [sourcePublicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("planning_month_copy_changes")
}

model PlanningSeedConsumption {
  actionId          String   @id @map("action_id") @db.Uuid
  spaceId           String   @map("space_id") @db.Uuid
  planMonthId       String   @unique @map("plan_month_id") @db.Uuid
  seedId            String   @map("seed_id") @db.VarChar(64)
  seedVersion       Int      @map("seed_version")
  seedSchemaVersion String   @map("seed_schema_version") @db.VarChar(128)
  actorPersona      String   @map("actor_persona") @db.VarChar(16)
  denisMemberId     String   @map("member_a_member_id") @db.Uuid
  tanyaMemberId     String   @map("member_b_member_id") @db.Uuid
  seededGoalCount   Int      @map("seeded_goal_count")
  goalDefinitionIds String[] @map("goal_definition_ids") @db.Uuid
  afterOrder        String[] @map("after_order") @db.Uuid

  action      PlanningActionGroup @relation(fields: [actionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  space       Space               @relation(fields: [spaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  planMonth   PlanMonth           @relation(fields: [spaceId, planMonthId], references: [spaceId, id], onDelete: Restrict, onUpdate: Restrict)
  denisMember Membership          @relation("SeedDenisMember", fields: [spaceId, denisMemberId], references: [spaceId, id], onDelete: Restrict, onUpdate: Restrict)
  tanyaMember Membership          @relation("SeedTanyaMember", fields: [spaceId, tanyaMemberId], references: [spaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([spaceId, seedId])
  @@unique([spaceId, planMonthId])
  @@map("planning_seed_consumptions")
}

model TrackingFactRecord {
  id                 String   @id @db.Uuid
  spaceId            String   @map("space_id") @db.Uuid
  planMonthId        String   @map("plan_month_id") @db.Uuid
  publicationId      String   @map("publication_id") @db.Uuid
  planGoalSnapshotId String   @map("plan_goal_snapshot_id") @db.Uuid
  localDate          DateTime @map("local_date") @db.Date
  factKind           String   @map("fact_kind") @db.VarChar(24)
  fixedExpectationId String?  @map("fixed_expectation_id") @db.Uuid
  flexiblePeriodId   String?  @map("flexible_period_id") @db.Uuid
  contributionId     String?  @unique @map("contribution_id") @db.Uuid
  checklistItemId    String?  @map("checklist_item_id") @db.Uuid
  orVariantId        String?  @map("or_variant_id") @db.Uuid
  currentRevisionId  String?  @map("current_revision_id") @db.Uuid
  createdByMemberId  String   @map("created_by_member_id") @db.Uuid
  createdAt          DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @map("updated_at") @db.Timestamptz(3)

  space            Space                  @relation(fields: [spaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  planMonth        PlanMonth              @relation(fields: [spaceId, planMonthId], references: [spaceId, id], onDelete: Restrict, onUpdate: Restrict)
  publication      PlanPublication        @relation(fields: [planMonthId, publicationId], references: [planMonthId, id], onDelete: Restrict, onUpdate: Restrict)
  planGoalSnapshot PlanGoalSnapshot       @relation(fields: [publicationId, planGoalSnapshotId], references: [publicationId, id], onDelete: Restrict, onUpdate: Restrict)
  fixedExpectation FixedExpectation?      @relation(fields: [fixedExpectationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  flexiblePeriod   FlexiblePeriod?        @relation(fields: [flexiblePeriodId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy        Membership             @relation("FactRecordCreator", fields: [spaceId, createdByMemberId], references: [spaceId, id], onDelete: Restrict, onUpdate: Restrict)
  revisions        TrackingFactRevision[] @relation("FactRecordRevisions")
  currentRevision  TrackingFactRevision?  @relation("CurrentFactRevision", fields: [id, currentRevisionId], references: [factRecordId, id], onDelete: Restrict, onUpdate: Restrict)
  changes          TrackingFactChange[]

  @@unique([id, spaceId])
  @@unique([id, currentRevisionId])
  @@index([publicationId, planGoalSnapshotId, localDate])
  @@map("tracking_fact_records")
}

model TrackingFactRevision {
  id                 String    @id @db.Uuid
  factRecordId       String    @map("fact_record_id") @db.Uuid
  revisionNumber     BigInt    @map("revision_number") @db.BigInt
  revisionKind       String    @map("revision_kind") @db.VarChar(16)
  booleanResult      String?   @map("boolean_result") @db.VarChar(16)
  quantityValue      String?   @map("quantity_value") @db.Text
  actualTimeValue    DateTime? @map("actual_time_value") @db.Time(0)
  ratingValue        BigInt?   @map("rating_value") @db.BigInt
  textValue          String?   @map("text_value") @db.Text
  textResult         String?   @map("text_result") @db.VarChar(16)
  checklistItemState String?   @map("checklist_item_state") @db.VarChar(16)
  orVariantValue     String?   @map("or_variant_value") @db.Text
  recordedByMemberId String    @map("recorded_by_member_id") @db.Uuid
  createdAt          DateTime  @map("created_at") @db.Timestamptz(3)

  factRecord    TrackingFactRecord   @relation("FactRecordRevisions", fields: [factRecordId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentFor    TrackingFactRecord?  @relation("CurrentFactRevision")
  recordedBy    Membership           @relation("FactRevisionActor", fields: [recordedByMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  beforeChanges TrackingFactChange[] @relation("FactChangeBeforeRevision")
  afterChanges  TrackingFactChange[] @relation("FactChangeAfterRevision")

  @@unique([factRecordId, revisionNumber])
  @@unique([factRecordId, id])
  @@map("tracking_fact_revisions")
}

model TrackingActionGroup {
  id                  String   @id @db.Uuid
  actionKind          String   @map("action_kind") @db.VarChar(32)
  actorKind           String   @map("actor_kind") @db.VarChar(16)
  actorScope          String   @map("actor_scope") @db.VarChar(64)
  memberId            String   @map("member_id") @db.Uuid
  spaceId             String   @map("space_id") @db.Uuid
  planMonthId         String   @map("plan_month_id") @db.Uuid
  publicationId       String   @map("publication_id") @db.Uuid
  planGoalSnapshotId  String   @map("plan_goal_snapshot_id") @db.Uuid
  commandType         String   @map("command_type") @db.VarChar(128)
  commandId           String   @map("command_id") @db.Uuid
  beforeFactsRevision BigInt   @map("before_facts_revision") @db.BigInt
  afterFactsRevision  BigInt   @map("after_facts_revision") @db.BigInt
  reason              String?  @db.Text
  occurredAt          DateTime @map("occurred_at") @db.Timestamptz(3)

  member           Membership          @relation(fields: [spaceId, memberId], references: [spaceId, id], onDelete: Restrict, onUpdate: Restrict)
  space            Space               @relation(fields: [spaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  planMonth        PlanMonth           @relation(fields: [spaceId, planMonthId], references: [spaceId, id], onDelete: Restrict, onUpdate: Restrict)
  publication      PlanPublication     @relation(fields: [planMonthId, publicationId], references: [planMonthId, id], onDelete: Restrict, onUpdate: Restrict)
  planGoalSnapshot PlanGoalSnapshot    @relation(fields: [publicationId, planGoalSnapshotId], references: [publicationId, id], onDelete: Restrict, onUpdate: Restrict)
  commandReceipt   CommandReceipt      @relation(fields: [actorScope, commandType, commandId], references: [actorScope, commandType, commandId], onDelete: Restrict, onUpdate: Restrict)
  factChange       TrackingFactChange?

  @@unique([actorScope, commandType, commandId])
  @@unique([planMonthId, afterFactsRevision], map: "tracking_action_groups_month_facts_revision_key")
  @@map("tracking_action_groups")
}

model TrackingFactChange {
  actionId         String  @id @map("action_id") @db.Uuid
  factRecordId     String  @map("fact_record_id") @db.Uuid
  beforeRevisionId String? @map("before_revision_id") @db.Uuid
  afterRevisionId  String  @unique(map: "tracking_fact_changes_after_revision_key") @map("after_revision_id") @db.Uuid

  action         TrackingActionGroup   @relation(fields: [actionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  factRecord     TrackingFactRecord    @relation(fields: [factRecordId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  beforeRevision TrackingFactRevision? @relation("FactChangeBeforeRevision", fields: [factRecordId, beforeRevisionId], references: [factRecordId, id], onDelete: Restrict, onUpdate: Restrict)
  afterRevision  TrackingFactRevision  @relation("FactChangeAfterRevision", fields: [factRecordId, afterRevisionId], references: [factRecordId, id], onDelete: Restrict, onUpdate: Restrict)

  @@map("tracking_fact_changes")
}
