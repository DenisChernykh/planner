generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  engineType   = "client"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String      @id @default(uuid()) @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  membership Membership?

  @@map("users")
}

model Space {
  id                  String                    @id @default(uuid()) @db.Uuid
  singletonKey        Int                       @unique @default(1) @map("singleton_key") @db.SmallInt
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships         Membership[]
  planMonths          PlanMonth[]
  goalDefinitions     GoalDefinition[]
  seedConsumptions    PlanningSeedConsumption[]
  trackingFactRecords TrackingFactRecord[]
  trackingActions     TrackingActionGroup[]

  @@map("spaces")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  spaceId   String   @map("space_id") @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  slot      Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  space                   Space                     @relation(fields: [spaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  allowlist               TelegramAccessAllowlist?
  planningActions         PlanningActionGroup[]
  ownedDraftGoalRevisions PlanDraftGoalRevision[]
  publishedPlans          PlanPublication[]
  ownedGoalSnapshots      PlanGoalSnapshot[]
  denisSeedBindings       PlanningSeedConsumption[] @relation("SeedDenisMember")
  tanyaSeedBindings       PlanningSeedConsumption[] @relation("SeedTanyaMember")
  createdFactRecords      TrackingFactRecord[]      @relation("FactRecordCreator")
  recordedFactRevisions   TrackingFactRevision[]    @relation("FactRevisionActor")
  trackingActions         TrackingActionGroup[]
  dayClosures             TrackingDayClosure[]
  reminderSchedule        ReminderSchedule?
  reminderOccurrences     ReminderOccurrence[]
  notificationAttempts    NotificationAttempt[]

  @@unique([spaceId, slot])
  @@unique([spaceId, id])
  @@unique([spaceId, userId])
  @@map("memberships")
}

model TelegramAccessAllowlist {
  userId     String @unique @map("user_id") @db.Uuid
  spaceId    String @map("space_id") @db.Uuid
  telegramId BigInt @unique @map("telegram_id") @db.BigInt

  membership Membership                 @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Restrict, onUpdate: Cascade)
  identities TelegramExternalIdentity[]

  @@id([spaceId, userId])
  @@unique([userId, telegramId])
  @@map("telegram_access_allowlist")
}

model TelegramExternalIdentity {
  issuer         String   @db.VarChar(255)
  subject        String   @db.VarChar(255)
  providerUserId BigInt   @map("provider_user_id") @db.BigInt
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  allowlist TelegramAccessAllowlist @relation(fields: [userId, providerUserId], references: [userId, telegramId], onDelete: Restrict, onUpdate: Restrict)

  @@id([issuer, subject])
  @@unique([issuer, providerUserId])
  @@unique([issuer, userId])
  @@map("telegram_external_identities")
}

model TelegramIngressState {
  consumerKey  String   @id @map("consumer_key") @db.VarChar(64)
  nextUpdateId BigInt   @map("next_update_id") @db.BigInt
  revision     BigInt   @default(0) @db.BigInt
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(3)

  @@map("telegram_ingress_state")
}

model TelegramActionIntent {
  id                        String    @id @db.Uuid
  semanticKey               String    @map("semantic_key") @db.Char(64)
  commandId                 String    @unique @map("command_id") @db.Uuid
  spaceId                   String    @map("space_id") @db.Uuid
  memberId                  String    @map("member_id") @db.Uuid
  publicationId             String    @map("publication_id") @db.Uuid
  planGoalSnapshotId        String?   @map("plan_goal_snapshot_id") @db.Uuid
  localDate                 DateTime  @map("local_date") @db.Date
  sourceFactsRevision       BigInt    @map("source_facts_revision") @db.BigInt
  intentKind                String    @map("intent_kind") @db.VarChar(32)
  state                     String    @db.VarChar(24)
  checkpointId              String?   @map("checkpoint_id") @db.Uuid
  booleanResult             String?   @map("boolean_result") @db.VarChar(16)
  textResult                String?   @map("text_result") @db.VarChar(16)
  checklistItemId           String?   @map("checklist_item_id") @db.Uuid
  checklistItemState        String?   @map("checklist_item_state") @db.VarChar(16)
  orVariantId               String?   @map("or_variant_id") @db.Uuid
  quantityValue             String?   @map("quantity_value") @db.Text
  actualTimeValue           DateTime? @map("actual_time_value") @db.Time(0)
  ratingValue               BigInt?   @map("rating_value") @db.BigInt
  textValue                 String?   @map("text_value") @db.Text
  orVariantValue            String?   @map("or_variant_value") @db.Text
  factRecordId              String?   @map("fact_record_id") @db.Uuid
  expectedRecordRevision    BigInt?   @map("expected_record_revision") @db.BigInt
  flexiblePeriodId          String?   @map("flexible_period_id") @db.Uuid
  reason                    String?   @db.Text
  closePreviewSchemaVersion String?   @map("close_preview_schema_version") @db.VarChar(64)
  closePreviewHashVersion   String?   @map("close_preview_hash_version") @db.VarChar(64)
  closePreviewHash          String?   @map("close_preview_hash") @db.Char(64)
  closeUnresolvedCount      Int?      @map("close_unresolved_count")
  commandFingerprint        String?   @map("command_fingerprint") @db.Char(64)
  resultKind                String?   @map("result_kind") @db.VarChar(128)
  resultAggregateId         String?   @map("result_aggregate_id") @db.Uuid
  resultAggregateRevision   BigInt?   @map("result_aggregate_revision") @db.BigInt
  expiresAt                 DateTime  @map("expires_at") @db.Timestamptz(3)
  completedAt               DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt                 DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime  @map("updated_at") @db.Timestamptz(3)

  @@index([spaceId, memberId, state])
  @@index([expiresAt])
  @@map("telegram_action_intents")
}

model PlanMonth {
  id                  String   @id @default(uuid()) @db.Uuid
  spaceId             String   @map("space_id") @db.Uuid
  monthStart          DateTime @map("month_start") @db.Date
  status              String   @db.VarChar(16)
  revision            BigInt   @db.BigInt
  factsRevision       BigInt   @default(0) @map("facts_revision") @db.BigInt
  createdAt           DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @map("updated_at") @db.Timestamptz(3)
  /// Backed by a physical DEFERRABLE composite FK to
  /// plan_publications(plan_month_id,id), which Prisma cannot model exactly.
  activePublicationId String?  @map("active_publication_id") @db.Uuid

  space             Space                    @relation(fields: [spaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  draft             PlanDraft?
  actions           PlanningActionGroup[]
  draftGoals        PlanDraftGoal[]
  publications      PlanPublication[]
  activePublication PlanPublication?         @relation("ActivePlanPublication", fields: [id, activePublicationId], references: [planMonthId, id], onDelete: Restrict, onUpdate: Restrict, map: "plan_months_active_publication_fkey")
  seedConsumption   PlanningSeedConsumption?
  factRecords       TrackingFactRecord[]
  trackingActions   TrackingActionGroup[]

  @@unique([spaceId, monthStart])
  @@unique([spaceId, id])
  @@map("plan_months")
}

model PlanDraft {
  planMonthId String   @id @map("plan_month_id") @db.Uuid
  focus       String   @db.Text
  revision    BigInt   @db.BigInt
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(3)

  planMonth    PlanMonth         @relation(fields: [planMonthId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  publications PlanPublication[]

  @@map("plan_drafts")
}

model CommandReceipt {
  actorScope        String   @map("actor_scope") @db.VarChar(64)
  commandType       String   @map("command_type") @db.VarChar(128)
  commandId         String   @map("command_id") @db.Uuid
  fingerprint       String   @db.Char(64)
  resultKind        String   @map("result_kind") @db.VarChar(128)
  aggregateId       String   @map("aggregate_id") @db.Uuid
  aggregateRevision BigInt   @map("aggregate_revision") @db.BigInt
  completedAt       DateTime @map("completed_at") @db.Timestamptz(3)

  planningActions PlanningActionGroup[]
  reminderScheduleChanges ReminderScheduleChange[]
  trackingActions TrackingActionGroup[]

  @@id([actorScope, commandType, commandId])
  @@map("command_receipts")
}

model PlanningActionGroup {
  id               String   @id @default(uuid()) @db.Uuid
  actionKind       String   @map("action_kind") @db.VarChar(32)
  actorKind        String   @map("actor_kind") @db.VarChar(16)
  actorScope       String   @map("actor_scope") @db.VarChar(64)
  memberId         String?  @map("member_id") @db.Uuid
  systemActorId    String?  @map("system_actor_id") @db.VarChar(32)
  planMonthId      String?  @map("plan_month_id") @db.Uuid
  goalDefinitionId String?  @map("goal_definition_id") @db.Uuid
  commandType      String   @map("command_type") @db.VarChar(128)
  commandId        String   @map("command_id") @db.Uuid
  beforeRevision   BigInt?  @map("before_revision") @db.BigInt
  afterRevision    BigInt   @map("after_revision") @db.BigInt
  occurredAt       DateTime @map("occurred_at") @db.Timestamptz(3)

  member            Membership?                @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  planMonth         PlanMonth?                 @relation(fields: [planMonthId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  goalDefinition    GoalDefinition?            @relation(fields: [goalDefinitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  commandReceipt    CommandReceipt             @relation(fields: [actorScope, commandType, commandId], references: [actorScope, commandType, commandId], onDelete: Restrict, onUpdate: Restrict)
  focusChange       PlanningMonthFocusChange?
  goalCatalogChange PlanningGoalCatalogChange?
  draftGoalChange   PlanningDraftGoalChange?
  publicationChange PlanningPublicationChange?
  monthCopyChange   PlanningMonthCopyChange?
  seedConsumption   PlanningSeedConsumption?

  @@unique([actorScope, commandType, commandId])
  @@map("planning_action_groups")
}

model ReminderSchedule {
  id        String   @id @default(uuid()) @db.Uuid
  spaceId   String   @map("space_id") @db.Uuid
  memberId  String   @unique @map("member_id") @db.Uuid
  revision  BigInt   @default(1) @db.BigInt
  timeZone  String   @map("time_zone") @db.VarChar(64)
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  member      Membership              @relation(fields: [spaceId, memberId], references: [spaceId, id], onDelete: Restrict, onUpdate: Cascade)
  slots       ReminderScheduleSlot[]
  occurrences ReminderOccurrence[]
  changes     ReminderScheduleChange[]

  @@unique([spaceId, memberId])
  @@unique([spaceId, id])
  @@unique([spaceId, id, memberId])
  @@map("reminder_schedules")
}

model ReminderScheduleSlot {
  id         String    @id @default(uuid()) @db.Uuid
  scheduleId String    @map("schedule_id") @db.Uuid
  slotKind   String    @map("slot_kind") @db.VarChar(16)
  localTime  DateTime? @map("local_time") @db.Time(0)
  nextDueAt  DateTime? @map("next_due_at") @db.Timestamptz(3)
  createdAt  DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @map("updated_at") @db.Timestamptz(3)

  schedule ReminderSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([scheduleId, slotKind])
  @@index([nextDueAt, slotKind, id])
  @@map("reminder_schedule_slots")
}

model ReminderOccurrence {
  id                String    @id @default(uuid()) @db.Uuid
  spaceId           String    @map("space_id") @db.Uuid
  recipientMemberId String    @map("recipient_member_id") @db.Uuid
  scheduleId        String    @map("schedule_id") @db.Uuid
  localDate         DateTime  @map("local_date") @db.Date
  slotKind          String    @map("slot_kind") @db.VarChar(16)
  scheduleRevision  BigInt    @map("schedule_revision") @db.BigInt
  dueAt             DateTime  @map("due_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  state             String    @db.VarChar(16)
  leaseOwner        String?   @map("lease_owner") @db.VarChar(128)
  leaseUntil        DateTime? @map("lease_until") @db.Timestamptz(3)
  fencingToken      BigInt    @default(0) @map("fencing_token") @db.BigInt
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(3)

  recipient Membership       @relation(fields: [spaceId, recipientMemberId], references: [spaceId, id], onDelete: Restrict, onUpdate: Cascade)
  schedule  ReminderSchedule @relation(fields: [spaceId, scheduleId, recipientMemberId], references: [spaceId, id, memberId], onDelete: Restrict, onUpdate: Cascade)
  notificationAttempts NotificationAttempt[]

  @@unique([recipientMemberId, localDate, slotKind], map: "reminder_occurrences_recipient_date_slot_key")
  @@index([state, dueAt, expiresAt, id], map: "reminder_occurrences_due_scan_idx")
  @@index([scheduleId, slotKind, localDate, state], map: "reminder_occurrences_schedule_slot_idx")
  @@map("reminder_occurrences")
}

model NotificationIntent {
  id                  String   @id @db.Uuid
  occurrenceId        String   @map("occurrence_id") @db.Uuid
  spaceId             String   @map("space_id") @db.Uuid
  recipientMemberId   String   @map("recipient_member_id") @db.Uuid
  publicationId       String   @map("publication_id") @db.Uuid
  localDate           DateTime @map("local_date") @db.Date
  slotKind            String   @map("slot_kind") @db.VarChar(16)
  sourceFactsRevision BigInt   @map("source_facts_revision") @db.BigInt
  intentRevision      BigInt   @map("intent_revision") @db.BigInt
  contentSchemaVersion String  @map("content_schema_version") @db.VarChar(100)
  content             Json     @db.JsonB
  contentHash         String   @map("content_hash") @db.Char(64)
  expiresAt           DateTime @map("expires_at") @db.Timestamptz(3)
  supersedesIntentId  String?  @map("supersedes_intent_id") @db.Uuid
  createdAt           DateTime @map("created_at") @db.Timestamptz(3)

  attempts NotificationAttempt[]

  @@unique([id, occurrenceId, spaceId, recipientMemberId], map: "notification_intents_identity_key")
  @@unique([occurrenceId, intentRevision])
  @@unique([occurrenceId, sourceFactsRevision, contentHash])
  @@index([occurrenceId, intentRevision])
  @@index([spaceId, recipientMemberId, expiresAt])
  @@map("notification_intents")
}

model NotificationAttempt {
  id                    String    @id @db.Uuid
  intentId              String    @map("intent_id") @db.Uuid
  occurrenceId          String    @map("occurrence_id") @db.Uuid
  spaceId               String    @map("space_id") @db.Uuid
  recipientMemberId     String    @map("recipient_member_id") @db.Uuid
  attemptNumber         Int       @map("attempt_number")
  state                 String    @db.VarChar(16)
  fencingToken          BigInt    @default(0) @map("fencing_token") @db.BigInt
  outcome               String?   @db.VarChar(16)
  outcomeReason         String?   @map("outcome_reason") @db.VarChar(32)
  providerRetryAfterSec Int?      @map("provider_retry_after_sec")
  startedAt             DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt           DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt             DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(3)

  intent    NotificationIntent  @relation(fields: [intentId, occurrenceId, spaceId, recipientMemberId], references: [id, occurrenceId, spaceId, recipientMemberId], onUpdate: Restrict, onDelete: Restrict)
  occurrence ReminderOccurrence @relation(fields: [occurrenceId], references: [id], onUpdate: Restrict, onDelete: Restrict)
  recipient Membership          @relation(fields: [spaceId, recipientMemberId], references: [spaceId, id], onUpdate: Cascade, onDelete: Restrict)

  @@unique([intentId, attemptNumber])
  @@index([state, createdAt, id])
  @@index([occurrenceId, attemptNumber])
  @@index([spaceId, recipientMemberId, outcome, completedAt])
  @@map("notification_attempts")
}

model ReminderScheduleChange {
  actionId          String    @id @map("action_id") @db.Uuid
  scheduleId        String    @map("schedule_id") @db.Uuid
  spaceId           String    @map("space_id") @db.Uuid
  memberId          String    @map("member_id") @db.Uuid
  actorScope        String    @map("actor_scope") @db.VarChar(64)
  commandType       String    @map("command_type") @db.VarChar(128)
  commandId         String    @map("command_id") @db.Uuid
  beforeRevision    BigInt?   @map("before_revision") @db.BigInt
  afterRevision     BigInt    @map("after_revision") @db.BigInt
  beforeMorning     DateTime? @map("before_morning") @db.Time(0)
  beforeDay         DateTime? @map("before_day") @db.Time(0)
  beforeEvening     DateTime? @map("before_evening") @db.Time(0)
  afterMorning      DateTime? @map("after_morning") @db.Time(0)
  afterDay          DateTime? @map("after_day") @db.Time(0)
  afterEvening      DateTime? @map("after_evening") @db.Time(0)
  occurredAt        DateTime  @map("occurred_at") @db.Timestamptz(3)

  schedule      ReminderSchedule @relation(fields: [spaceId, scheduleId, memberId], references: [spaceId, id, memberId], onDelete: Restrict, onUpdate: Cascade)
  commandReceipt CommandReceipt  @relation(fields: [actorScope, commandType, commandId], references: [actorScope, commandType, commandId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([actorScope, commandType, commandId])
  @@map("reminder_schedule_changes")
}

model PlanningMonthFocusChange {
  actionId    String  @id @map("action_id") @db.Uuid
  beforeFocus String? @map("before_focus") @db.Text
  afterFocus  String  @map("after_focus") @db.Text

  action PlanningActionGroup @relation(fields: [actionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("planning_month_focus_changes")
}

model GoalDefinition {
  id         String    @id @default(uuid()) @db.Uuid
  spaceId    String    @map("space_id") @db.Uuid
  state      String    @db.VarChar(16)
  revision   BigInt    @db.BigInt
  createdAt  DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @map("updated_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  space             Space                       @relation(fields: [spaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  series            GoalSeries[]
  versions          GoalDefinitionVersion[]
  actions           PlanningActionGroup[]
  catalogChanges    PlanningGoalCatalogChange[] @relation("CatalogChangeTarget")
  copiedFromChanges PlanningGoalCatalogChange[] @relation("CatalogChangeSource")
  draftGoals        PlanDraftGoal[]

  @@unique([spaceId, id])
  @@index([spaceId, state, createdAt, id])
  @@map("goal_definitions")
}

model GoalSeries {
  id               String   @id @default(uuid()) @db.Uuid
  goalDefinitionId String   @map("goal_definition_id") @db.Uuid
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)

  goalDefinition     GoalDefinition          @relation(fields: [goalDefinitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions           GoalDefinitionVersion[]
  draftGoalRevisions PlanDraftGoalRevision[]
  goalSnapshots      PlanGoalSnapshot[]

  @@unique([goalDefinitionId, id])
  @@map("goal_series")
}

model GoalDefinitionVersion {
  id               String   @id @default(uuid()) @db.Uuid
  goalDefinitionId String   @map("goal_definition_id") @db.Uuid
  versionNumber    BigInt   @map("version_number") @db.BigInt
  goalSeriesId     String   @map("goal_series_id") @db.Uuid
  seriesDecision   String   @map("series_decision") @db.VarChar(16)
  title            String   @db.Text
  why              String   @db.Text
  category         String   @db.Text
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)

  goalDefinition           GoalDefinition              @relation(fields: [goalDefinitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  goalSeries               GoalSeries                  @relation(fields: [goalDefinitionId, goalSeriesId], references: [goalDefinitionId, id], onDelete: Restrict, onUpdate: Restrict)
  catalogBeforeChanges     PlanningGoalCatalogChange[] @relation("CatalogBeforeVersion")
  catalogAfterChanges      PlanningGoalCatalogChange[] @relation("CatalogAfterVersion")
  catalogCopySourceChanges PlanningGoalCatalogChange[] @relation("CatalogCopySourceVersion")
  draftGoalRevisions       PlanDraftGoalRevision[]
  goalSnapshots            PlanGoalSnapshot[]

  @@unique([goalDefinitionId, versionNumber])
  @@unique([goalDefinitionId, id])
  @@map("goal_definition_versions")
}

model PlanningGoalCatalogChange {
  actionId               String  @id @map("action_id") @db.Uuid
  goalDefinitionId       String  @map("goal_definition_id") @db.Uuid
  beforeState            String? @map("before_state") @db.VarChar(16)
  afterState             String  @map("after_state") @db.VarChar(16)
  beforeVersionId        String? @map("before_version_id") @db.Uuid
  afterVersionId         String? @map("after_version_id") @db.Uuid
  copySourceDefinitionId String? @map("copy_source_definition_id") @db.Uuid
  copySourceVersionId    String? @map("copy_source_version_id") @db.Uuid
  seriesDecision         String? @map("series_decision") @db.VarChar(16)

  action               PlanningActionGroup    @relation(fields: [actionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  goalDefinition       GoalDefinition         @relation("CatalogChangeTarget", fields: [goalDefinitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  beforeVersion        GoalDefinitionVersion? @relation("CatalogBeforeVersion", fields: [goalDefinitionId, beforeVersionId], references: [goalDefinitionId, id], onDelete: Restrict, onUpdate: Restrict)
  afterVersion         GoalDefinitionVersion? @relation("CatalogAfterVersion", fields: [goalDefinitionId, afterVersionId], references: [goalDefinitionId, id], onDelete: Restrict, onUpdate: Restrict)
  copySourceDefinition GoalDefinition?        @relation("CatalogChangeSource", fields: [copySourceDefinitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  copySourceVersion    GoalDefinitionVersion? @relation("CatalogCopySourceVersion", fields: [copySourceDefinitionId, copySourceVersionId], references: [goalDefinitionId, id], onDelete: Restrict, onUpdate: Restrict)

  @@map("planning_goal_catalog_changes")
}

model PlanDraftGoal {
  id                String    @id @default(uuid()) @db.Uuid
  spaceId           String    @map("space_id") @db.Uuid
  planMonthId       String    @map("plan_month_id") @db.Uuid
  goalDefinitionId  String    @map("goal_definition_id") @db.Uuid
  displayOrder      Int       @map("display_order")
  currentRevisionId String?   @map("current_revision_id") @db.Uuid
  attachedAt        DateTime  @map("attached_at") @db.Timestamptz(3)
  detachedAt        DateTime? @map("detached_at") @db.Timestamptz(3)
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(3)

  planMonth          PlanMonth                 @relation(fields: [spaceId, planMonthId], references: [spaceId, id], onDelete: Restrict, onUpdate: Restrict)
  goalDefinition     GoalDefinition            @relation(fields: [spaceId, goalDefinitionId], references: [spaceId, id], onDelete: Restrict, onUpdate: Restrict)
  revisions          PlanDraftGoalRevision[]   @relation("DraftGoalRevisions")
  currentRevision    PlanDraftGoalRevision?    @relation("CurrentDraftGoalRevision", fields: [id, currentRevisionId], references: [planGoalId, id], onDelete: Restrict, onUpdate: Restrict)
  changes            PlanningDraftGoalChange[]
